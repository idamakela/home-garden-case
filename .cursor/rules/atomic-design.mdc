}
```

```tsx
// Bad — monolithic route; new atoms inline; fetch in the component
export default function HomePage() {
  const [gardens, setGardens] = useState([]);

  useEffect(() => {
    fetch('/gardens').then((r) => r.json()).then(setGardens);
  }, []);

  return (
    <div>
      <header>
        <img src="/logo.svg" alt="" />
        <form>
          <label>Search</label>
          <input />
          <button type="submit">Go</button>
        </form>
      </header>
      <ul>
        {gardens.map((g) => (
          <li key={g.id} style={{ padding: 12 }}>
            {g.name}
          </li>
        ))}
      </ul>
    </div>
  );
}
```

```tsx
// Bad — atom importing a molecule; reversed dependency
import { SearchField } from '../molecules/SearchField';

export function Button(props: { children: React.ReactNode }) {
  return (
    <button type="button">
      {props.children}
      <SearchField label="Find" value="" onChange={() => {}} onSubmit={() => {}} />
    </button>
  );
}
```
